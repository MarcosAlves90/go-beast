{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go-beast.dev/schemas/go-beast.task.schema.json",
  "title": "go-beast v2 task record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "task_id", "status", "agent", "profile", "paths", "compatibility", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "task"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "status": {"enum": ["initialized", "planned", "running", "paused", "completed", "failed"]},
    "agent": {"type": ["string", "null"]},
    "profile": {"type": ["string", "null"]},
    "adapter": {"type": ["string", "null"]},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_record", "plan", "manifest", "state"],
      "properties": {
        "task_record": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "plan": {"type": ["string", "null"]},
        "manifest": {"type": ["string", "null"]},
        "state": {"type": ["string", "null"]}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v1_namespaces", "v2_facade"],
      "properties": {
        "v1_namespaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "v2_facade": {"const": true}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
