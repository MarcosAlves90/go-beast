        "post_tool_use": {"native": "PostToolUse", "canonical": "post-tool-use", "supported": true}
      },
      "config_paths": ["~/.claude/settings.json"],
      "install": {
        "hook_dir": "~/.claude/hooks",
        "config_path": "~/.claude/settings.json",
        "native_format": "claude",
        "preserves_unmanaged": true
      },
      "degradation": [
        {"capability": "tool-events", "when": "native payload omits tool metadata", "behavior": "continue with lifecycle-only evidence and report the missing tool fields"},
        {"capability": "prompt-context", "when": "native prompt context injection is unavailable", "behavior": "fall back to Markdown instructions and report the adapter limitation"}
      ],
      "compatibility": {"contract_range": "^2.0.0", "min_node": "18", "trace_version": 1},
      "ownership": {"managed_by": "go-beast", "key_strategy": "event+matcher+command", "preserves_unmanaged": true},
