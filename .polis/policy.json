{
  "schema_version": 3,
  "validation_level": "standard",
  "gates": [
    {
      "id": "test.complete",
      "mode": "command",
      "command": {
        "argv": [
          "npm",
          "run",
          "verify"
        ],
        "cwd": ".",
        "timeout_seconds": 1200,
        "environment": {
          "mode": "clean",
          "pass": [
            "PATH",
            "HOME",
            "TMPDIR",
            "TMP",
            "TEMP",
            "SystemRoot",
            "COMSPEC",
            "PATHEXT",
            "USERPROFILE",
            "LOCALAPPDATA"
          ]
        }
      }
    },
    {
      "id": "coverage",
      "mode": "not_applicable",
      "reason": "disabled by explicit validation configuration at level \"standard\""
    },
    {
      "id": "lint",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for lint"
    },
    {
      "id": "typecheck",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for typecheck"
    },
    {
      "id": "build",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for build"
    },
    {
      "id": "smoke",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for smoke"
    },
    {
      "id": "compatibility",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for compatibility"
    },
    {
      "id": "dependency",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for dependency"
    },
    {
      "id": "migration",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for migration"
    },
    {
      "id": "security",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for security"
    },
    {
      "id": "platform",
      "mode": "not_applicable",
      "reason": "custom profile has no explicit command for platform"
    }
  ]
}
