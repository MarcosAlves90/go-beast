{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "go-beast workflow manifest",
  "type": "object",
  "required": ["schema_version", "id", "version", "phases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "enum": [1, 2] },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["off", "warn", "strict"] },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "strategy": { "const": "compiled" } }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill", "depends_on", "preconditions", "requires", "produces", "transitions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "skill": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "preconditions": { "type": "array", "items": { "type": "object" } },
          "requires": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
          "produces": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
          "transitions": { "type": "array", "items": { "type": "string" } },
          "parallel_group": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_attempts"],
            "properties": {
              "max_attempts": { "type": "integer", "minimum": 1 },
              "backoff_ms": { "type": "integer", "minimum": 0 }
            }
          },
          "handoff": {
            "type": "object",
            "additionalProperties": false,
            "required": ["targets"],
            "properties": {
              "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "checkpoint": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "type", "non_empty"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "enum": ["file", "directory"] },
        "non_empty": { "type": "boolean" },
        "sections": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
