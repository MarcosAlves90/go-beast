{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "go-beast workflow manifest",
  "type": "object",
  "required": ["schema_version", "id", "version", "phases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["off", "warn", "strict"] },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "skill", "depends_on", "preconditions", "requires", "produces", "transitions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "skill": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "preconditions": { "type": "array", "items": { "type": "object" } },
          "requires": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
          "produces": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
          "transitions": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "type", "non_empty"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "enum": ["file", "directory"] },
        "non_empty": { "type": "boolean" },
        "sections": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
