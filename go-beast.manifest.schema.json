{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "go-beast transversal rules manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_version",
    "title",
    "principles",
    "precedence",
    "required_phases",
    "expected_artifacts",
    "execution_constraints",
    "hook_integration",
    "orchestration",
    "federated_sources",
    "reserved_aliases",
    "skills",
    "derived_surfaces"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "manifest_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "principles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "precedence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "required_phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "artifact"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "artifact": { "type": "string" } }
      },
      "minItems": 1
    },
    "expected_artifacts": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "execution_constraints": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "hook_integration": {
      "type": "object",
      "required": ["contract", "wiring", "session_sync"],
      "additionalProperties": false,
      "properties": {
        "contract": { "type": "string" },
        "wiring": { "type": "string" },
        "session_sync": { "type": "string" }
      }
    },
    "orchestration": {
      "type": "object",
      "required": ["artifacts", "external_nodes", "consumers"],
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "produced_by", "consumed_by"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "label": { "type": "string", "minLength": 1 },
              "produced_by": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
              "consumed_by": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "external_nodes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "command", "required", "surfaces"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "command": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "surfaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
            }
          }
        }
      }
    },
    "federated_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "source"],
        "additionalProperties": false,
        "properties": { "domain": { "type": "string" }, "source": { "type": "string" } }
      },
      "minItems": 1
    },
    "reserved_aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["alias", "description", "phase", "when_to_use", "prerequisites", "input_artifacts", "output_artifacts", "gates", "depends_on", "conflicts_with"],
        "additionalProperties": false,
        "properties": {
          "alias": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string", "minLength": 1 },
          "phase": { "type": "string", "minLength": 1 },
          "when_to_use": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "prerequisites": { "type": "array", "items": { "type": "string" } },
          "input_artifacts": { "type": "array", "items": { "type": "string" } },
          "output_artifacts": { "type": "array", "items": { "type": "string" } },
          "gates": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "conflicts_with": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "derived_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "marker"],
        "additionalProperties": false,
        "properties": { "path": { "type": "string" }, "marker": { "type": "string" } }
      },
      "minItems": 1
    }
  }
}
